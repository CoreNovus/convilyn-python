{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.CoreNovus/convilyn",
  "title": "Convilyn",
  "description": "Convert documents to Markdown on your own machine — .docx, .pptx, .xlsx, .odt, .pdf, .epub and ~50 more — with no tokens, no network and no model in the path. Returns output paths rather than text, so a batch of twenty costs the same as one. Optional hosted tools price a run before it happens.",
  "version": "4.1.0",
  "repository": {
    "url": "https://github.com/CoreNovus/convilyn-python",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "convilyn",
      "version": "4.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "convilyn[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "group",
          "value": "mcp"
        },
        {
          "type": "positional",
          "valueHint": "command",
          "value": "serve"
        }
      ]
    }
  ]
}
